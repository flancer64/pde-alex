{
  "name": "@flancer32/pde-alex",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Digital Embassy for Alex.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "Pde_Alex_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      },
      "cli": {
        "command": {
          "default": "web:start"
        },
        "commands": [
          {
            "id": "db:migrate-runtime-schema",
            "summary": "Migrate the recognized legacy Runtime PostgreSQL schema without discarding source rows.",
            "component": "Pde_Alex_Cli_Command_RuntimeSchemaMigrate$"
          }
        ],
        "plugin": "Pde_Alex_Cli_Plugin$"
      }
    }
  },
  "scripts": {
    "start": "teq web:start"
  },
  "dependencies": {
    "@flancer32/pde-desk-echo": "github:flancer32/pde-desk-echo#main",
    "@flancer32/pde-desk-telegram": "github:flancer32/pde-desk-telegram#main",
    "@flancer32/pde-desk-world-map": "github:flancer32/pde-desk-world-map#main",
    "@flancer32/pde-runtime": "github:flancer32/pde-runtime#main",
    "@flancer32/pde-sdk": "github:flancer32/pde-sdk#main",
    "@prebuilt-tdlib/linux-x64-glibc": "0.1008066.0",
    "@teqfw/cli": "^2.2.0",
    "pg": "^8.23.0"
  }
}
