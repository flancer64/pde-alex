{
  "name": "@flancer32/pde-alex",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Digital Embassy for Alex.",
  "type": "module",
  "files": [
    "bootstrap",
    "etc",
    "LICENSE",
    "README.md",
    "src",
    "types.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "Pde_Alex_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      },
      "cli": {
        "container": {
          "configurator": "./bootstrap/di-config.mjs"
        },
        "command": {
          "default": "web:start"
        },
        "commands": [
          {
            "id": "app:check",
            "summary": "Check application startup and package composition.",
            "component": "Pde_Alex_Cli_Command_AppCheck$"
          }
        ],
        "plugin": "Pde_Alex_Cli_Plugin$"
      }
    }
  },
  "scripts": {
    "start": "teq web:start",
    "check:app": "teq app:check",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@flancer32/pde-desk-echo": "git+https://github.com/flancer32/pde-desk-echo.git#main",
    "@flancer32/pde-desk-files": "git+https://github.com/flancer32/pde-desk-files.git#main",
    "@flancer32/pde-desk-telegram": "git+https://github.com/flancer32/pde-desk-telegram.git#main",
    "@flancer32/pde-desk-world-map": "git+https://github.com/flancer32/pde-desk-world-map.git#main",
    "@flancer32/pde-runtime": "git+https://github.com/flancer32/pde-runtime.git#main",
    "@flancer32/pde-sdk": "git+https://github.com/flancer32/pde-sdk.git#main",
    "@flancer32/teq-cms": "git+https://github.com/flancer32/teq-cms.git#main",
    "@flancer32/teq-tmpl": "git+https://github.com/flancer32/teq-tmpl.git#main",
    "@prebuilt-tdlib/linux-x64-glibc": "^0.1008067.0",
    "@teqfw/cli": "^2.5.0",
    "@teqfw/di": "^2.11.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "sqlite3": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "tdl@8.1.0": true
  }
}
